{
  "name": "color-tools",
  "version": "1.0.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:cloudflare": "ng build --configuration cloudflare",
    "watch": "ng build --watch --configuration development",
